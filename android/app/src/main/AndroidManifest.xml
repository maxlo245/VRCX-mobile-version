<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	package="com.vrcx.mobile">

	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<!-- POST_NOTIFICATIONS required on Android 13+ -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<application
		android:allowBackup="true"
		android:label="VRCX Mobile"
		android:icon="@mipmap/ic_launcher">

		<service
			android:name="com.vrcx.mobile.websocket.WebSocketForegroundService"
			android:foregroundServiceType="connectedDevice|dataSync"
			android:exported="false" />

		<receiver android:name="com.vrcx.mobile.boot.BootReceiver">
			<intent-filter>
				<action android:name="android.intent.action.BOOT_COMPLETED" />
			</intent-filter>
		</receiver>

	</application>
</manifest>
